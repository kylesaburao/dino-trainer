# Training artifacts: bulky/intermediate checkpoints, logs, locks, temp files.
# best.json and metrics.* in a run directory are small and are committed.
runs/*/checkpoint*.json
runs/*/*.log
runs/*/*.lock
runs/*/*.tmp
# Behaviour-cloning demonstrations (regenerate with bc-gen; demos.json is committed).
runs/*/demos.bin
# Smoke-test runs are throwaway.
runs/smoke*/
.DS_Store
# Superseded / experimental runs from the first training session (kept locally, not committed).
runs/h16/
runs/exp-*/
runs/v2-h16/
# Local Python analysis environment.
.venv/
